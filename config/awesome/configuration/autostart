#!/bin/sh
# Autostart script - graceful degradation for missing dependencies

# Helper: start command only if binary exists and not already running
safe_start() {
    local cmd="$1"; shift
    local bin="${cmd%% *}"
    command -v "$bin" >/dev/null 2>&1 || { echo "[autostart] $bin no encontrado, saltando" >&2; return 0; }
    if ! pgrep -f "$cmd" >/dev/null 2>&1; then
        "$cmd" "$@" &
    fi
}

# Detectar si estamos en VM (para ajustar compositor)
IS_VM=0
VM_FLAG="$HOME/.cache/awesome/vm-detected"

# 1. Check flag file (set by setup-sddm-vm.sh or first successful detection)
if [ -f "$VM_FLAG" ]; then
    IS_VM=1
fi

# 2. systemd-detect-virt (most reliable)
if [ "$IS_VM" -eq 0 ] && command -v systemd-detect-virt >/dev/null 2>&1; then
    VM_TYPE=$(systemd-detect-virt 2>/dev/null)
    if [ -n "$VM_TYPE" ] && [ "$VM_TYPE" != "none" ]; then
        IS_VM=1
    fi
fi

# 3. DMI check (sys_vendor/board_name)
if [ "$IS_VM" -eq 0 ]; then
    for f in /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/board_name /sys/class/dmi/id/product_name; do
        if [ -f "$f" ] && grep -qi "virtualbox\|vbox\|vmware\|qemu\|kvm\|microsoft\|hyper\|parallels\|xen\|bochs\|innotek" "$f" 2>/dev/null; then
            IS_VM=1
            break
        fi
    done
fi

# 4. /proc/cpuinfo hypervisor flag
if [ "$IS_VM" -eq 0 ] && grep -qi "hypervisor" /proc/cpuinfo 2>/dev/null; then
    IS_VM=1
fi

# 5. Check for virtio devices
if [ "$IS_VM" -eq 0 ] && ls /sys/bus/virtio/devices/ 2>/dev/null | head -1 | grep -q .; then
    IS_VM=1
fi

# Save flag for future sessions
if [ "$IS_VM" -eq 1 ]; then
    mkdir -p "$(dirname "$VM_FLAG")"
    touch "$VM_FLAG"
fi

# Check 3D acceleration in VM using glxinfo
HAS_3D=0
if [ "$IS_VM" -eq 1 ] && command -v glxinfo >/dev/null 2>&1; then
    # Get OpenGL renderer info
    GL_RENDERER=$(glxinfo 2>/dev/null | grep "OpenGL renderer" | cut -d: -f2 | xargs)
    if [ -n "$GL_RENDERER" ]; then
        # Check if renderer is software (no 3D acceleration)
        case "$GL_RENDERER" in
            *llvmpipe*|*swrast*|*softpipe*|*Software*|*Mesa*Offscreen*)
                HAS_3D=0
                echo "[autostart] VM: renderer software detectado ($GL_RENDERER), sin aceleracion 3D" >&2
                ;;
            *)
                HAS_3D=1
                echo "[autostart] VM: renderer hardware detectado ($GL_RENDERER), con aceleracion 3D" >&2
                ;;
        esac
    else
        echo "[autostart] VM: glxinfo no reporto renderer, asumiendo sin aceleracion 3D" >&2
    fi
elif [ "$IS_VM" -eq 1 ]; then
    echo "[autostart] VM: glxinfo no disponible, asumiendo sin aceleracion 3D" >&2
fi

# 1. Compositor (picom) - con fallback si falla
PICOM_CONF="$HOME/.config/awesome/theme/picom.conf"
IS_BLUR_MODE=0
IS_TRANSPARENCY_MODE=0

if [ -f "$HOME/.cache/awesome/blur-mode" ] || [ -f /tmp/awesome-blur-mode ]; then
    IS_BLUR_MODE=1
    PICOM_CONF="$HOME/.config/awesome/theme/picom-blur.conf"
elif [ -f "$HOME/.cache/awesome/transparency-mode" ] || [ -f /tmp/awesome-transparency-mode ]; then
    IS_TRANSPARENCY_MODE=1
    PICOM_CONF="$HOME/.config/awesome/theme/picom-transparency.conf"
fi

# En VM sin aceleracion 3D: usar configs con xrender (sin GLX)
# En VM con aceleracion 3D: usar configs normales (GLX)
PICOM_BACKEND=""
if [ "$IS_VM" -eq 1 ] && [ "$HAS_3D" -eq 0 ]; then
    PICOM_BACKEND="--backend xrender"
    echo "[autostart] VM sin aceleracion 3D, usando picom backend xrender" >&2

    if [ "$IS_BLUR_MODE" -eq 1 ]; then
        # Blur mode: usar config con box blur (compatible con xrender)
        if [ -f "$HOME/.config/awesome/theme/picom-blur-vm.conf" ]; then
            PICOM_CONF="$HOME/.config/awesome/theme/picom-blur-vm.conf"
            echo "[autostart] VM blur: picom-blur-vm.conf (box blur + xrender)" >&2
        else
            echo "[autostart] VM blur: picom-blur-vm.conf no encontrado, sin blur" >&2
            PICOM_CONF="$HOME/.config/awesome/theme/picom-vm.conf"
        fi
    elif [ "$IS_TRANSPARENCY_MODE" -eq 1 ]; then
        # Transparency mode: usar config con xrender
        if [ -f "$HOME/.config/awesome/theme/picom-transparency-vm.conf" ]; then
            PICOM_CONF="$HOME/.config/awesome/theme/picom-transparency-vm.conf"
            echo "[autostart] VM transparency: picom-transparency-vm.conf (xrender)" >&2
        else
            PICOM_CONF="$HOME/.config/awesome/theme/picom-vm.conf"
            echo "[autostart] VM transparency: fallback a picom-vm.conf" >&2
        fi
    else
        # Normal mode: usar config con xrender
        if [ -f "$HOME/.config/awesome/theme/picom-vm.conf" ]; then
            PICOM_CONF="$HOME/.config/awesome/theme/picom-vm.conf"
            echo "[autostart] VM normal: picom-vm.conf (xrender)" >&2
        else
            echo "[autostart] VM: picom-vm.conf no encontrado, usando picom.conf" >&2
        fi
    fi
elif [ "$IS_VM" -eq 1 ] && [ "$HAS_3D" -eq 1 ]; then
    echo "[autostart] VM con aceleracion 3D, usando picom backend glx (config normal)" >&2
fi

if command -v picom >/dev/null 2>&1; then
    if ! pgrep -f "picom.*--config" >/dev/null 2>&1; then
        picom -b --dbus $PICOM_BACKEND --config "$PICOM_CONF" 2>/dev/null || \
            echo "[autostart] picom falló con --dbus, probando sin..." >&2 && \
            picom -b $PICOM_BACKEND --config "$PICOM_CONF" 2>/dev/null || \
            echo "[autostart] picom no disponible, continuando sin compositor" >&2
    fi
else
    echo "[autostart] picom no instalado, saltando compositor" >&2
fi

# 2. Polkit agent
safe_start /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# Fallback para distros con path diferente
safe_start /usr/lib/polkit-kde-authentication-agent-1

# 3. PulseAudio systray (pasystray) - opcional
safe_start pasystray

# 4. Cargar X resources
command -v xrdb >/dev/null 2>&1 && [ -f "$HOME/.Xresources" ] && xrdb "$HOME/.Xresources" &

# 5. Touchegg client (gestos touchpad) - solo si touchegg daemon está corriendo
if command -v touchegg >/dev/null 2>&1; then
    if pgrep -u "$USER" -f "touchegg.*--daemon" >/dev/null 2>&1; then
        safe_start touchegg --client
    else
        echo "[autostart] touchegg daemon no corriendo, saltando client" >&2
    fi
fi

# 6. Notification sink setup (audio routing)
safe_start "$HOME/.config/awesome/scripts/notif-sink-setup.sh"
