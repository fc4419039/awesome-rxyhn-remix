#!/bin/sh

start() {
  if ! pgrep -f "$1" > /dev/null 2>&1 ;
  then
    "$@" &
  fi
}

# music
start mpd
start mpd-mpris # add playerctl support to mpd

# compositor
start picom -b --dbus --config $HOME/.config/awesome/theme/picom.conf

# auth
start /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# load X colors
start xrdb $HOME/.Xresources
