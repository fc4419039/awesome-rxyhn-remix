#!/bin/sh

start() {
  if ! pgrep -f "$1" > /dev/null 2>&1 ;
  then
    "$@" &
  fi
}

# music
start mpd
start mpd-mpris # add playerctl support to mpd

# compositor
PICOM_CONF="$HOME/.config/awesome/theme/picom.conf"
if [ -f /tmp/awesome-blur-mode ]; then
    PICOM_CONF="$HOME/.config/awesome/theme/picom-blur.conf"
elif [ -f /tmp/awesome-transparency-mode ]; then
    PICOM_CONF="$HOME/.config/awesome/theme/picom-transparency.conf"
fi
start picom -b --dbus --config "$PICOM_CONF"

# auth
start /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# pulse audio systray
start pasystray

# load X colors
start xrdb $HOME/.Xresources

# clipboard history (se activa al presionar Super+Shift+V)

# touchegg client (gestos del touchpad)
pgrep -u "$(whoami)" -f "touchegg.*--client" > /dev/null 2>&1 || nohup touchegg --client > /dev/null 2>&1 &
