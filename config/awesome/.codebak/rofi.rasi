configuration {
    modi:                   "drun";
    display-drun:           "Apps";
    drun-display-format:    "{name}";
    font:                   "JetBrainsMono Nerd Font 10";
    show-icons:             true;
    icon-theme:             "Papirus";
    drun-icon-theme:        "Papirus";
    sidebar-mode:           false;
    kb-mode-next:           "Shift+Right,Control+Tab";
    kb-mode-previous:       "Shift+Left,Control+ISO_Left_Tab";
}

@theme "/dev/null"

* {
    bg:                     #0d0d1a;
    fg:                     #e2e8f0;
    fg-dim:                 #94a3b8;
    accent:                #8b5cf6;
    accent-dim:            #000000;
    surface:                #1a1a2e;
    darker:                 #141428;
    muted:                  #3d3d5c;
    rad:                    24px;
    rad-sm:                 14px;

    background-color:       transparent;
    text-color:             @fg;
}

window {
    transparency:           "real";
    width:                  580px;
    height:                 680px;
    location:               center;
    anchor:                 center;
    border-radius:          @rad;
    border:                 1px;
    border-color:           @accent;
    background-color: #0d0d1ab3;
}

mainbox {
    children:               [inputbar, listview];
    spacing:                0;
    padding:                0;
}

inputbar {
    children:               [textbox, entry];
    spacing:                0;
    margin:                 24px 24px 0 24px;
    padding:                0;
    border-radius:          @rad-sm;
    background-color:       @surface;
    border:                 1px;
    border-color:           @muted;
}

textbox {
    str:                    "󰀻";
    expand:                 false;
    padding:                0 0 0 16px;
    horizontal-align:       0.5;
    vertical-align:         0.5;
    text-color:             @accent;
    font:                   "JetBrainsMono Nerd Font 18";
    background-color:       transparent;
}

entry {
    expand:                 true;
    padding:                14px 16px 14px 10px;
    placeholder:            "Buscar aplicaciones...";
    placeholder-color:      @muted;
    border-radius:          0;
    background-color:       transparent;
    text-color:             @fg;
    font:                   "JetBrainsMono Nerd Font 12";
    highlight:              inherit;
}

listview {
    spacing:                2px;
    padding:                16px 24px 24px 24px;
    dynamic:                true;
    columns:                2;
    lines:                  7;
    cycle:                  false;
    scrollbar:              false;
    layout:                 vertical;
    cursor:                 pointer;
}

element {
    padding:                8px 12px;
    border-radius:          @rad-sm;
    background-color:       transparent;
    cursor:                 pointer;
    border:                 1px;
    border-color:           transparent;
}

element normal.normal {
    background-color:       transparent;
    border-color:           transparent;
}

element selected {
    background-color:       @darker;
    text-color:             @accent;
    border-color:           @muted;
}

element selected.normal {
    background-color:       @darker;
    border-color:           @muted;
}

element-icon {
    size:                   38px;
    padding:                0 12px 0 0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
}

element-text {
    padding:                2px 0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
    text-color:             @fg;
    font:                   "JetBrainsMono Nerd Font 11";
    highlight:              inherit;
}

element selected element-text {
    text-color:             @accent;
}

element alternate.normal {
    background-color:       transparent;
    border-color:           transparent;
}

element selected.alternate {
    background-color:       @darker;
    border-color:           @muted;
}

element-icon, element-text {
    background-color:       transparent;
}

scrollbar {
    handle-color:           @muted;
    handle-width:           4px;
    border-radius:          2px;
}

button {
    background-color:       @darker;
    text-color:             @fg;
    border-radius:          @rad-sm;
    cursor:                 pointer;
}

button selected {
    background-color:       @accent;
    text-color:             @bg;
}

error-message {
    background-color:       @bg;
    text-color:             @accent;
    border-radius:          @rad;
    padding:                40px;
}
