@theme "/dev/null"

* {
    bg:                     #0d0d1a;
    fg:                     #e2e8f0;
    fg-dim:                 #94a3b8;
    accent:                 #7c3aed;
    accent-dim:             #4c1d95;
    surface:                #1a1a2e;
    darker:                 #141428;
    muted:                  #3d3d5c;
    rad:                    20px;
    rad-sm:                 12px;

    background-color:       transparent;
    text-color:             @fg;
    border-color:           @accent;
}

window {
    transparency:           "real";
    width:                  340px;
    height:                 180px;
    location:               center;
    anchor:                 center;
    border-radius:          @rad;
    border:                 1px;
    border-color:           @muted;
    background-color:       #0d0d1aF2;
}

mainbox {
    spacing:                0;
    padding:                0;
    children:               [message, listview];
}

inputbar {
    enabled:                false;
}

message {
    spacing:                0;
    padding:                20px 24px 8px 24px;
    border-radius:          0;
    horizontal-align:       0.5;
    background-color:       transparent;
    text-color:             @fg;
    font:                   "JetBrainsMono Nerd Font 12";
}

listview {
    spacing:                8px;
    padding:                8px 24px 20px 24px;
    scrollbar:              false;
    columns:                2;
    layout:                 vertical;
    cursor:                 pointer;
}

element {
    padding:                10px 14px;
    border-radius:          @rad-sm;
    orientation:            horizontal;
    cursor:                 pointer;
    border:                 1px;
    border-color:           transparent;
    background-color:       transparent;
}

element normal.normal {
    background-color:       @darker;
    border-color:           transparent;
}

element normal.selected {
    background-color:       @surface;
    border-color:           @accent;
}

element selected.normal {
    background-color:       @surface;
    border-color:           @accent;
}

element-icon {
    size:                   20px;
    padding:                0 8px 0 0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
}

element-text {
    padding:                0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
    text-color:             @fg;
    font:                   "JetBrainsMono Nerd Font 11";
}

element selected element-text {
    text-color:             @accent;
}
