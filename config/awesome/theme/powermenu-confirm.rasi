@theme "/dev/null"

* {
    background: #0d0d1a;
    foreground: #e2e8f0;
    accent: #06b6d4;
    accent-dim: #155e75;
    surface: #1a1a2e;
    darker: #141428;
    muted: #3d3d5c;
    rad: 20px;
    rad-sm: 12px;
    background-color: transparent;
    text-color: var(foreground);
    border-color: var(muted);
}

window {
    transparency: "real";
    width: 340px;
    height: 180px;
    location: center;
    anchor: center;
    border-radius: var(rad);
    border: 1px;
    border-color: var(muted);
    background-color: #0d0d1ab3;
}

mainbox {
    spacing: 0;
    padding: 0;
    children: [message, listview];
}

inputbar {
    enabled: false;
}

message {
    spacing: 0;
    padding: 20px 24px 8px 24px;
    border-radius: 0;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color: var(foreground);
    font: "JetBrainsMono Nerd Font 12";
}

listview {
    spacing: 8px;
    padding: 8px 24px 20px 24px;
    scrollbar: false;
    columns: 2;
    layout: vertical;
    cursor: pointer;
}

element {
    padding: 10px 14px;
    border-radius: var(rad-sm);
    orientation: horizontal;
    cursor: pointer;
    border: 1px;
    border-color: transparent;
    background-color: transparent;
}

element normal.normal {
    background-color: var(darker);
    border-color: transparent;
}

element normal.selected {
    background-color: var(surface);
    border-color: var(accent);
}

element selected.normal {
    background-color: var(surface);
    border-color: var(accent);
}

element-icon {
    size: 20px;
    padding: 0 8px 0 0;
    horizontal-align: 0;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    padding: 0;
    horizontal-align: 0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: var(foreground);
    font: "JetBrainsMono Nerd Font 11";
}

element selected element-text {
    text-color: var(accent);
}