* {
    bg:                #061115;
    bg-alt:            #0c1a20;
    fg:                #d9d7d6;
    fg-dim:            #484e5b;
    cyan:              #67afc1;
    blue:              #6791c9;
    red:               #df5b61;

    background-color:  transparent;
    text-color:        @fg;
}

window {
    transparency:      "real";
    width:             320px;
    location:          center;
    anchor:            center;
    border-radius:     12px;
    background-color:  @bg;
    border:            1px;
    border-color:      @cyan;
    padding:           4px;
}

mainbox {
    spacing:           0;
    padding:           0;
    background-color:  transparent;
}

inputbar {
    enabled:           true;
    background-color:  @bg-alt;
    border-radius:     8px;
    padding:           6px 10px;
    margin:           4px 4px 0 4px;
    text-color:        @fg;
    font:              "Iosevka Nerd Font Mono 9";
    placeholder:       "Search...";
    placeholder-color: @fg-dim;
}

listview {
    spacing:           2px;
    padding:          4px;
    scrollbar:         false;
    background-color:  transparent;
    layout:            vertical;
}

element {
    padding:           6px 10px;
    border-radius:     8px;
    cursor:            pointer;
    text-color:        @fg;
    background-color:  transparent;
}

element selected {
    background-color:  @cyan;
    text-color:        @bg;
}

element-icon {
    size:              14px;
    padding:           0 6px 0 0;
}

element-text {
    vertical-align:    0.5;
    horizontal-align:  0.0;
    font:              "Iosevka Nerd Font Mono 9";
}
