@theme "/dev/null"

* {
    bg:                     #0d0d1a;
    fg:                     #e2e8f0;
    accent:                 #22d3ee;
    accent-dim:             #000000;
    surface:                #1a1a2e;
    darker:                 #141428;
    active:                 #06b6d4;
    active-dim:             #0891b2;
    muted:                  #3d3d5c;
    rad:                    16px;
    rad-sm:                 10px;

    background-color:       transparent;
    text-color:             @fg;
}

window {
    transparency:           "real";
    width:                  380px;
    height:                 520px;
    location:               center;
    anchor:                 center;
    border-radius:          @rad;
    border:                 2px;
    border-color:           @accent;
    background-color:       #0d0d1aF2;
    padding:                0;
}

mainbox {
    spacing:                0;
    padding:                0;
    background-color:       transparent;
}

inputbar {
    enabled:                true;
    margin:                 20px 20px 0 20px;
    border-radius:          @rad;
    background-color:       @darker;
    border:                 1px;
    border-color:           @muted;
    padding:                10px 16px;
    text-color:             @fg;
    font:                   "JetBrainsMono Nerd Font 10";
    placeholder:            "Search...";
    placeholder-color:      @muted;
    children:               [entry];
}

entry {
    expand:                 true;
    padding:                0;
    border-radius:          @rad;
    background-color:       transparent;
    text-color:             @fg;
    font:                   "JetBrainsMono Nerd Font 10";
    placeholder:            "Search...";
    placeholder-color:      @muted;
}

listview {
    spacing:                4px;
    padding:                16px 20px 20px 20px;
    scrollbar:              false;
    layout:                 vertical;
    dynamic:                true;
    cursor:                 pointer;
}

element {
    padding:                10px 14px;
    border-radius:          @rad-sm;
    cursor:                 pointer;
    text-color:             @fg;
    background-color:       transparent;
}

element normal.normal {
    background-color:       transparent;
}

element selected {
    background-color:       @darker;
    text-color:             @active;
    border:                 1px;
    border-color:           @active-dim;
}

element selected.normal {
    background-color:       @darker;
}

element-icon {
    size:                   18px;
    padding:                0 10px 0 0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
}

element-text {
    padding:                0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
    text-color:             inherit;
    font:                   "JetBrainsMono Nerd Font 10";
}

scrollbar {
    handle-color:           @accent-dim;
    handle-width:           4px;
    border-radius:          2px;
}
