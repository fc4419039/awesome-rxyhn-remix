@theme "/dev/null"

* {
    bg:                     #0d0d1a;
    fg:                     #e2e8f0;
    fg-dim:                 #94a3b8;
    accent:                 #06b6d4;
    surface:                #1a1a2e;
    darker:                 #141428;
    muted:                  #3d3d5c;
    rad:                    16px;
    rad-sm:                 10px;

    background-color:       transparent;
    text-color:             var(fg);
}

window {
    transparency:           "real";
    width:                  400px;
    height:                 300px;
    location:               center;
    anchor:                 center;
    border-radius:          var(rad);
    border:                 1px;
    border-color:           var(accent);
    background-color:       #0d0d1aF2;
}

mainbox {
    children:               [listview];
    spacing:                0;
    padding:                0;
}

inputbar {
    enabled:                false;
}

listview {
    spacing:                2px;
    padding:                12px;
    scrollbar:              false;
    columns:                1;
    layout:                 vertical;
    dynamic:                true;
    cursor:                 pointer;
}

element {
    padding:                10px 14px;
    border-radius:          var(rad-sm);
    background-color:       transparent;
    cursor:                 pointer;
    border:                 1px;
    border-color:           transparent;
}

element normal.normal {
    background-color:       transparent;
    border-color:           transparent;
}

element selected {
    background-color:       var(darker);
    border-color:           var(muted);
}

element selected.normal {
    background-color:       var(darker);
    border-color:           var(muted);
}

element-icon {
    size:                   0px;
    padding:                0;
    background-color:       transparent;
}

element-text {
    padding:                0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
    text-color:             var(fg);
    font:                   "JetBrainsMono Nerd Font 11";
}

element selected element-text {
    text-color:             var(accent);
}
