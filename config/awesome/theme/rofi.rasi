configuration {
    modi:                   "drun";
    display-drun:           "Apps";
    drun-display-format:    "{name}";
    font:                   "JetBrainsMono Nerd Font 10";
    show-icons:             true;
    icon-theme:             "Papirus";
    drun-icon-theme:        "Papirus";
    sidebar-mode:           false;
    kb-mode-next:           "Shift+Right,Control+Tab";
    kb-mode-previous:       "Shift+Left,Control+ISO_Left_Tab";
}

@theme "/dev/null"

* {
    bg:                     #0d0d1a;
    fg:                     #e2e8f0;
    accent:                #06b6d4;
    accent-dim:            #000000;
    surface:                #1a1a2e;
    darker:                 #141428;
    active:                 #06b6d4;
    active-dim:             #0891b2;
    muted:                  #3d3d5c;
    rad:                    16px;
    rad-sm:                 10px;

    background-color:       transparent;
    text-color:             @fg;
}

window {
    transparency:           "real";
    width:                  500px;
    height:                 600px;
    location:               center;
    anchor:                 center;
    border-radius:          @rad;
    border:                 2px;
    border-color:           @accent;
    background-color:       #0d0d1aF2;
    padding:                0;
}

mainbox {
    children:               [inputbar, listview];
    spacing:                0;
    padding:                0;
}

inputbar {
    children:               [textbox, entry];
    spacing:                0;
    margin:                 24px 24px 0 24px;
    border-radius:          @rad;
    background-color:       @darker;
    border:                 1px;
    border-color:           @muted;
}

textbox {
    str:                    "󰀻 ";
    expand:                 false;
    padding:                0 0 0 18px;
    horizontal-align:       0.5;
    vertical-align:         0.5;
    text-color:             @accent;
    font:                   "JetBrainsMono Nerd Font 20";
    background-color:       transparent;
}

entry {
    expand:                 true;
    padding:                16px 18px 16px 10px;
    placeholder:            "Buscar aplicaciones...";
    placeholder-color:      @muted;
    border-radius:          @rad;
    background-color:       transparent;
    text-color:             @fg;
    font:                   "JetBrainsMono Nerd Font 11";
}

listview {
    spacing:                6px;
    padding:                20px 24px 24px 24px;
    dynamic:                true;
    columns:                2;
    lines:                  6;
    cycle:                  false;
    scrollbar:              false;
    layout:                 vertical;
    cursor:                 pointer;
}

element {
    padding:                10px 14px;
    border-radius:          @rad-sm;
    background-color:       transparent;
    cursor:                 pointer;
}

element normal.normal {
    background-color:       transparent;
}

element selected {
    background-color:       @darker;
    text-color:             @active;
    border:                 1px;
    border-color:           @active-dim;
}

element selected.normal {
    background-color:       @darker;
}

element-icon {
    size:                   38px;
    padding:                0 12px 0 0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
}

element-text {
    padding:                0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
    text-color:             inherit;
    font:                   "JetBrainsMono Nerd Font 10";
}

element alternate.normal {
    background-color:       transparent;
}

element selected.alternate {
    background-color:       @darker;
}

element-icon, element-text {
    background-color:       transparent;
}

scrollbar {
    handle-color:           @accent-dim;
    handle-width:           4px;
    border-radius:          2px;
}

button {
    background-color:       @darker;
    text-color:             @fg;
    border-radius:          @rad-sm;
    cursor:                 pointer;
}

button selected {
    background-color:       @accent;
    text-color:             @bg;
}

error-message {
    background-color:       @bg;
    text-color:             @accent;
    border-radius:          @rad;
    padding:                40px;
}
