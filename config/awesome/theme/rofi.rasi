@theme "/dev/null"

configuration {
    show-icons: true;
    icon-theme: "Papirus";
    drun-icon-theme: "Papirus";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 10";
    sidebar-mode: false;
    kb-mode-next: "Shift+Right,Control+Tab";
    kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab";
}

* {
    background: #0a1419b3;
    foreground: #e2e8f0;
    accent: #06b6d4;
    surface: #162026cc;
    darker: #0a1419;
    muted: #666c79;
    rad: 14px;
    rad-sm: 10px;
    background-color: transparent;
    text-color: var(foreground);
}

window {
    transparency: "real";
    location: north west;
    anchor: north west;
    x-offset: 64px;
    y-offset: 15px;
    width: 280px;
    height: calc(100% - 30px);
    border-radius: var(rad);
    border: 1px;
    border-color: #06b6d433;
    background-color: var(background);
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
    padding: 16px;
    background-color: transparent;
}

inputbar {
    children: [ textbox, entry ];
    spacing: 8px;
    padding: 6px 10px;
    border-radius: var(rad-sm);
    background-color: var(surface);
    border: 1px;
    border-color: #06b6d440;
}

textbox {
    str: "󰀻";
    expand: false;
    padding: 0;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: var(accent);
    font: "JetBrainsMono Nerd Font 14";
    background-color: transparent;
}

entry {
    expand: true;
    placeholder: "Buscar aplicaciones...";
    placeholder-color: var(muted);
    border-radius: 0;
    background-color: transparent;
    text-color: var(foreground);
    font: "JetBrainsMono Nerd Font 11";
    highlight: inherit;
}

listview {
    columns: 1;
    spacing: 2px;
    scrollbar: true;
    cursor: pointer;
    background-color: transparent;
}

element {
    padding: 8px 10px;
    border-radius: var(rad-sm);
    background-color: transparent;
    cursor: pointer;
    border: 1px;
    border-color: transparent;
}

element normal.normal {
    background-color: transparent;
    border-color: transparent;
}

element selected {
    background-color: #16202680;
    text-color: var(accent);
    border-color: var(muted);
}

element selected.normal {
    background-color: #16202680;
    border-color: var(muted);
}

element-icon {
    size: 22px;
    padding: 0 10px 0 0;
    horizontal-align: 0;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    padding: 2px 0;
    horizontal-align: 0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: var(foreground);
    font: "JetBrainsMono Nerd Font 11";
    highlight: inherit;
}

element selected element-text {
    text-color: var(accent);
}

element alternate.normal {
    background-color: transparent;
    border-color: transparent;
}

element selected.alternate {
    background-color: #16202680;
    border-color: var(muted);
}

element-icon, element-text {
    background-color: transparent;
}

scrollbar {
    handle-color: var(muted);
    handle-width: 4px;
    border-radius: 2px;
}

button {
    background-color: var(surface);
    text-color: var(foreground);
    border-radius: var(rad-sm);
    cursor: pointer;
}

button selected {
    background-color: var(accent);
    text-color: var(background);
}

error-message {
    background-color: var(background);
    text-color: var(accent);
    border-radius: var(rad);
    padding: 40px;
}
