@theme "/dev/null"

configuration {
    show-icons: false;
    font: "JetBrainsMono Nerd Font 10";
    sidebar-mode: false;
}

* {
    background: #0d0d1a;
    foreground: #e2e8f0;
    accent: #06b6d4;
    surface: #1a1a2e;
    darker: #141428;
    muted: #3d3d5c;
    rad: 14px;
    background-color: transparent;
    text-color: var(foreground);
}

window {
    transparency: "real";
    width: 500px;
    height: 400px;
    location: center;
    anchor: center;
    border-radius: var(rad);
    border: 1px;
    border-color: var(accent);
    background-color: #0d0d1ab3;
}

mainbox {
    children: [inputbar, listview];
    spacing: 0;
    padding: 0;
}

inputbar {
    children: [textbox, entry];
    spacing: 0;
    margin: 16px 16px 0 16px;
    padding: 0;
    border-radius: var(rad);
    background-color: var(surface);
    border: 1px;
    border-color: var(muted);
}

textbox {
    str: "󰅇";
    expand: false;
    padding: 0 0 0 12px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: var(accent);
    font: "JetBrainsMono Nerd Font 16";
    background-color: transparent;
}

entry {
    expand: true;
    padding: 12px 12px 12px 8px;
    placeholder: "Buscar en el historial...";
    placeholder-color: var(muted);
    border-radius: 0;
    background-color: transparent;
    text-color: var(foreground);
    font: "JetBrainsMono Nerd Font 11";
    highlight: inherit;
}

listview {
    spacing: 2px;
    padding: 12px 16px 16px 16px;
    dynamic: true;
    columns: 1;
    lines: 8;
    cycle: false;
    scrollbar: false;
    layout: vertical;
    cursor: pointer;
}

element {
    padding: 6px 10px;
    border-radius: 8px;
    background-color: transparent;
    cursor: pointer;
    border: 1px;
    border-color: transparent;
}

element normal.normal {
    background-color: transparent;
    border-color: transparent;
}

element selected {
    background-color: var(darker);
    text-color: var(accent);
    border-color: var(muted);
}

element selected.normal {
    background-color: var(darker);
    border-color: var(muted);
}

element-text {
    padding: 2px 0;
    horizontal-align: 0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: var(foreground);
    font: "JetBrainsMono Nerd Font 10";
    highlight: inherit;
}

element selected element-text {
    text-color: var(accent);
}

error-message {
    background-color: var(background);
    text-color: var(accent);
    border-radius: var(rad);
    padding: 20px;
}
