@theme "/dev/null"

* {
    bg:                     #0d0d1a;
    fg:                     #e2e8f0;
    fg-dim:                 #94a3b8;
    accent:                 #06b6d4;
    surface:                #1a1a2e;
    darker:                 #141428;
    muted:                  #3d3d5c;
    rad:                    16px;
    rad-sm:                 10px;

    background-color:       transparent;
    text-color:             @fg;
}

window {
    transparency:           "real";
    width:                  300px;
    height:                 380px;
    location:               center;
    anchor:                 center;
    border-radius:          @rad;
    border:                 1px;
    border-color:           @accent;
    background-color:       #0d0d1aF2;
}

mainbox {
    spacing:                0;
    padding:                0;
    children:               [listview];
}

inputbar {
    enabled:                false;
}

listview {
    spacing:                4px;
    padding:                14px;
    scrollbar:              false;
    columns:                1;
    layout:                 vertical;
    dynamic:                true;
    cursor:                 pointer;
}

element {
    padding:                8px 12px;
    border-radius:          @rad-sm;
    orientation:            horizontal;
    cursor:                 pointer;
    border:                 1px;
    border-color:           transparent;
    background-color:       transparent;
}

element normal.normal {
    background-color:       transparent;
    border-color:           transparent;
}

element selected {
    background-color:       @darker;
    border-color:           @muted;
}

element selected.normal {
    background-color:       @darker;
}

element-icon {
    size:                   0px;
    padding:                0;
    background-color:       transparent;
}

element-text {
    padding:                8px 6px;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
    text-color:             @fg;
    font:                   "JetBrainsMono Nerd Font 11";
}

element alternate.normal {
    background-color:       transparent;
}

element selected.alternate {
    background-color:       @darker;
}
