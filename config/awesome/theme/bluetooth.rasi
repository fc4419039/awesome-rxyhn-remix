@theme "/dev/null"

configuration {
    font:                   "JetBrainsMono Nerd Font 10";
}

* {
    bg:                     #0d0d1a;
    fg:                     #e2e8f0;
    accent:                 #7c3aed;
    accent-dim:             #4c1d95;
    surface:                #1a1a2e;
    darker:                 #141428;
    active:                 #06b6d4;
    active-dim:             #0891b2;
    muted:                  #3d3d5c;
    rad:                    16px;
    rad-sm:                 10px;

    background-color:       transparent;
    text-color:             @fg;
}

window {
    transparency:           "real";
    width:                  280px;
    height:                 340px;
    location:               center;
    anchor:                 center;
    border-radius:          @rad;
    border:                 2px;
    border-color:           @accent;
    background-color:       #0d0d1aF2;
    padding:                0;
}

mainbox {
    spacing:                0;
    padding:                0;
    children:               [inputbar, listview];
}

inputbar {
    enabled:                false;
}

listview {
    spacing:                4px;
    padding:                16px;
    scrollbar:              false;
    layout:                 vertical;
    dynamic:                true;
    cursor:                 pointer;
}

element {
    padding:                12px 16px;
    border-radius:          @rad-sm;
    background-color:       transparent;
    cursor:                 pointer;
}

element normal.normal {
    background-color:       transparent;
}

element selected {
    background-color:       @darker;
    text-color:             @active;
    border:                 1px;
    border-color:           @active;
}

element selected.normal {
    background-color:       @darker;
}

element-icon {
    size:                   22px;
    padding:                0 12px 0 0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
}

element-text {
    padding:                0;
    horizontal-align:       0;
    vertical-align:         0.5;
    background-color:       transparent;
    text-color:             inherit;
    font:                   "JetBrainsMono Nerd Font 10";
}

scrollbar {
    handle-color:           @accent;
    handle-width:           4px;
    border-radius:          2px;
}
