@theme "/dev/null"

* {
    bg:             #1a1b26;
    fg:             #a9b1d6;
    active:         #7dcfff;

    background-color: @bg;
    text-color:     @fg;
}

window {
    transparency:   "real";
    width:          200px;
    height:         200px;
    location:       center;
    anchor:         center;
    border-radius:  16px;
}

mainbox {
    spacing:        0;
    padding:        0;
    children:       [listview];
}

inputbar {
    enabled:        false;
}

listview {
    spacing:        2px;
    padding:        8px;
    scrollbar:      false;
}

element {
    padding:        6px 8px;
    border-radius:  6px;
    cursor:         pointer;
}

element normal {
    background-color: transparent;
}

element selected {
    background-color: @active;
    text-color:     @bg;
}
