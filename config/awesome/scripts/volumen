.mute-btn:hover {
    background-color: rgba(103, 175, 193, 0.15);
    border-color: #67afc1;
}

.mute-btn:checked {
    background-color: rgba(223, 91, 97, 0.2);
    border-color: #df5b61;
}

.no-apps {
    font-family: "Iosevka Nerd Font Mono";
    font-style: italic;
    color: #484e5b;
    padding: 16px;
}
"""

class VolumeControl(Gtk.Window):
    def __init__(self):
        Gtk.Window.__init__(self, title="Control de Volumen")
        self.set_default_size(520, 420)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("audio-volume-high")
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)

        settings = Gtk.Settings.get_default()
        settings.props.gtk_application_prefer_dark_theme = True

        self.css_provider = Gtk.CssProvider()
        self.css_provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self.css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.get_style_context().add_class("window-close")

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("Control de Volumen")
        header.set_subtitle("Por aplicación")
        header.props.has_subtitle = True
        self.set_titlebar(header)

        refresh_btn = Gtk.Button()
        refresh_icon = Gtk.Image.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
        refresh_btn.add(refresh_icon)
        refresh_btn.set_tooltip_text("Refrescar")
        refresh_btn.connect("clicked", self.refresh)
        header.pack_start(refresh_btn)

        notif_mute_btn = Gtk.ToggleButton()
        self.notif_mute_img = Gtk.Image.new_from_icon_name("notifications-disabled-symbolic", Gtk.IconSize.BUTTON)
        notif_mute_btn.add(self.notif_mute_img)
        notif_mute_btn.set_tooltip_text("Silenciar notificaciones")
        notif_mute_btn.connect("toggled", self.toggle_notif_mute_global)
        header.pack_end(notif_mute_btn)
        self.notif_mute_btn = notif_mute_btn

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_size_request(-1, 380)
        vbox.pack_start(scrolled, True, True, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.get_style_context().add_class("listbox")
        scrolled.add(self.listbox)

        self.add(vbox)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key_press)

        self.ensure_router()
        self.refresh()

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()

    def get_sink_inputs(self):
        result = subprocess.run(
            ["pactl", "list", "sink-inputs"],
            capture_output=True, text=True
        )
        output = result.stdout

        sinks = []
        current = None
        for line in output.split('\n'):
            if 'Sink Input #' in line:
                if current:
                    sinks.append(current)
                current = {'id': line.split('#')[1].strip().rstrip(':')}
            elif current:
                m = re.match(r'\s+application\.(\w+)\s*=\s*"(.+)"', line)
                if m:
                    current[m.group(1)] = m.group(2)
                m = re.match(r'\s+media\.(\w+)\s*=\s*"(.+)"', line)
                if m:
                    current['media.' + m.group(1)] = m.group(2)
                m2 = re.match(r'\s+(Volume:|Mute:)', line)
                if m2:
                    key = m2.group(1).rstrip(':').lower()
                    if key == 'volume' and 'front-left' in line:
                        vm = re.search(r'(\d+)%', line)
                        if vm:
                            current['volume'] = int(vm.group(1))
                    elif key == 'mute':
                        current['muted'] = 'yes' in line

        if current:
            sinks.append(current)

        return sinks

    def get_loopback_si(self):
        result = subprocess.run(["pactl", "list", "modules", "short"], capture_output=True, text=True)
        loop_mod = None
        for line in result.stdout.strip().split("\n"):
            if "module-loopback" in line and "notifications.monitor" in line:
                loop_mod = line.split()[0]
                break
        if not loop_mod:
            return None

        result = subprocess.run(["pactl", "list", "sink-inputs"], capture_output=True, text=True)
        blocks = result.stdout.strip().split("\n\n")
        for block in blocks:
            if f"Owner Module: {loop_mod}" in block:
                m = re.search(r"Sink Input #(\d+)", block)
                if m:
                    return m.group(1)
        return None

    def get_si_vol_and_mute(self, si):
        result = subprocess.run(["pactl", "list", "sink-inputs"], capture_output=True, text=True)
        blocks = result.stdout.split("Sink Input #")
        for block in blocks:
            if block.startswith(si + "\n") or block.startswith(si + ":"):
                vol_m = re.search(r'(\d+)%', block)
                muted = 'Mute: yes' in block
                vol = int(vol_m.group(1)) if vol_m else 100
                return vol, muted
        return None, None

    def get_notif_vol(self):
        si = self.get_loopback_si()
        if si:
            vol, _ = self.get_si_vol_and_mute(si)
            if vol is not None:
                return vol
        result = subprocess.run(["pactl", "get-sink-volume", NOTIF_SINK_NAME], capture_output=True, text=True)
        m = re.search(r'(\d+)%', result.stdout)
        return int(m.group(1)) if m else 100

    def is_notif_muted(self):
        si = self.get_loopback_si()
        if si:
            _, muted = self.get_si_vol_and_mute(si)
            if muted is not None:
                return muted
        result = subprocess.run(["pactl", "get-sink-mute", NOTIF_SINK_NAME], capture_output=True, text=True)
        return 'yes' in result.stdout

    def ensure_router(self):
        router = os.path.expanduser("~/.config/awesome/scripts/notification-router.sh")
        if os.access(router, os.X_OK):
            result = subprocess.run(["pgrep", "-f", "notification-router.sh"], capture_output=True, text=True)
            if not result.stdout.strip():
                subprocess.Popen(["nohup", router], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def get_notif_sink_id(self):
        result = subprocess.run(["pactl", "list", "sinks", "short"], capture_output=True, text=True)
        for line in result.stdout.strip().split("\n"):
            parts = line.split()
            if len(parts) >= 2 and parts[1] == NOTIF_SINK_NAME:
                return parts[0]
        return None

    def move_notif_streams(self):
        notif_sink = self.get_notif_sink_id()
        if not notif_sink:
            return
        result = subprocess.run(["pactl", "list", "sink-inputs"], capture_output=True, text=True)
        blocks = result.stdout.strip().split("\n\nSink Input #")
        for block in blocks:
            if not block.strip():
                continue
            if not block.startswith("Sink Input #"):
                block = "Sink Input #" + block
            lines = block.split("\n")
            sid = None
            sink = None
            props = []
            for line in lines:
                if line.startswith("Sink Input #"):
                    sid = line.split("#")[1].strip().rstrip(":")
                elif line.strip().startswith("Sink:"):
                    sink = line.split()[-1].strip()
                prop_m = re.search(r'\s+(media\.role|application\.name|media\.name)\s*=\s*"(.+)"', line)
                if prop_m:
                    props.append(prop_m.group(2).lower())
            if sid and sink and sink != notif_sink:
                is_notif = False
                for p in props:
                    if any(k in p for k in ["notification", "event", "alarm", "alert", "paplay", "libcanberra"]):
                        is_notif = True
                        break
                if is_notif:
                    subprocess.run(["pactl", "move-sink-input", sid, NOTIF_SINK_NAME],
                                 capture_output=True)

    def set_vol(self, target, pct):
        if target == "notifications":
            si = self.get_loopback_si()
            if si:
                subprocess.run(["pactl", "set-sink-input-volume", si, f"{pct}%"], capture_output=True)
            else:
                subprocess.run(["pactl", "set-sink-volume", NOTIF_SINK_NAME, f"{pct}%"], capture_output=True)
            self.move_notif_streams()
        else:
            subprocess.run(["pactl", "set-sink-input-volume", target, f"{pct}%"], capture_output=True)

    def toggle_notif_mute(self):
        si = self.get_loopback_si()
        if si:
            subprocess.run(["pactl", "set-sink-input-mute", si, "toggle"], capture_output=True)
        else:
            subprocess.run(["pactl", "set-sink-mute", NOTIF_SINK_NAME, "toggle"], capture_output=True)
        self.refresh()

    def toggle_notif_mute_global(self, btn):
        self.toggle_notif_mute()

    def on_scale_changed(self, scale, target, vol_label):
        value = int(scale.get_value())
        vol_label.set_text(f"{value}%")
        self.set_vol(target, value)

    def on_scale_drag_end(self, scale, target, vol_label):
        value = int(scale.get_value())
        self.set_vol(target, value)

    def get_app_icon(self, app):
        icon_name = app.get('icon_name') or app.get('process.binary') or 'audio-x-generic'
        theme = Gtk.IconTheme.get_default()
        icon = theme.lookup_icon(icon_name, 28, 0)
        if icon:
            return icon.load_icon()
        icon2 = theme.lookup_icon('audio-x-generic', 28, 0)
        if icon2:
            return icon2.load_icon()
        return None

    def add_app_row(self, name, vol, target, muted=False, is_notif=False, media_name=None, icon_name=None):
        row = Gtk.ListBoxRow()
        row.set_activatable(False)
        row.get_style_context().add_class("app-row" if not is_notif else "notif-row")

        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.add(hbox)

        if not is_notif and icon_name:
            img = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.LARGE_TOOLBAR)
            img.set_pixel_size(28)
            img.get_style_context().add_class("app-icon")
            hbox.pack_start(img, False, False, 4)
        elif is_notif:
            icon = "notifications-disabled-symbolic" if muted else "notifications-symbolic"
            img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
            img.set_pixel_size(24)
            img.get_style_context().add_class("app-icon")
            hbox.pack_start(img, False, False, 4)
        else:
            img = Gtk.Image.new_from_icon_name("audio-x-generic", Gtk.IconSize.LARGE_TOOLBAR)
            img.set_pixel_size(24)
            img.get_style_context().add_class("app-icon")
            hbox.pack_start(img, False, False, 4)

        text_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        name_label = Gtk.Label(label=name, xalign=0)
        name_label.get_style_context().add_class("app-name")
        name_label.set_ellipsize(3)
        name_label.set_max_width_chars(20)
        text_vbox.pack_start(name_label, False, False, 0)

        if media_name and not is_notif:
            src_label = Gtk.Label(label=media_name, xalign=0)
            src_label.get_style_context().add_class("app-source")
            src_label.set_ellipsize(3)
            src_label.set_max_width_chars(25)
            text_vbox.pack_start(src_label, False, False, 0)

        hbox.pack_start(text_vbox, False, False, 4)

        scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 0, 100, 1
        )
        scale.set_value(vol)
        scale.set_size_request(160, -1)
        scale.set_digits(0)
        scale.set_hexpand(True)
        scale.set_slider_size_fixed(False)

        vol_label = Gtk.Label(label=f"{vol}%", xalign=0)
        vol_label.get_style_context().add_class("vol-label")

        scale.connect("value-changed", self.on_scale_changed, target, vol_label)
        scale.connect("button-release-event", self.on_scale_drag_end, target, vol_label)

        hbox.pack_start(scale, True, True, 5)
        hbox.pack_start(vol_label, False, False, 5)

        if is_notif:
            mute_btn = Gtk.ToggleButton()
            mute_btn.set_active(muted)
            mute_btn.get_style_context().add_class("mute-btn")
            mute_icon = Gtk.Image.new_from_icon_name(
                "notifications-disabled-symbolic" if muted else "notifications-symbolic",
                Gtk.IconSize.BUTTON
            )
            mute_btn.add(mute_icon)
            mute_btn.connect("toggled", lambda btn: self.toggle_notif_mute())
            hbox.pack_start(mute_btn, False, False, 0)

        self.listbox.add(row)

    def refresh(self, widget=None):
        self.move_notif_streams()
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        apps = self.get_sink_inputs()

        if not apps:
            no_apps = Gtk.ListBoxRow()
            no_apps.set_activatable(False)
            no_apps.get_style_context().add_class("no-apps")
            label = Gtk.Label(label="  Ninguna aplicación reproduciendo audio", xalign=0)
            no_apps.add(label)
            self.listbox.add(no_apps)

        loopback_si = self.get_loopback_si()
        for app in apps:
            if loopback_si and app['id'] == loopback_si:
                continue
            name = app.get('name', f"App #{app['id']}")
            vol = app.get('volume', 100)
            target = app['id']
            muted = app.get('muted', False)
            icon_name = app.get('icon_name') or app.get('process.binary')
            media_name = app.get('media.name')
            self.add_app_row(name, vol, target, muted,
                           media_name=media_name,
                           icon_name=icon_name)

        notif_vol = self.get_notif_vol()
        notif_muted = self.is_notif_muted()
        self.add_app_row("Notificaciones", notif_vol, "notifications", notif_muted, is_notif=True)

        nicon = "notifications-symbolic" if not notif_muted else "notifications-disabled-symbolic"
        self.notif_mute_img.set_from_icon_name(nicon, Gtk.IconSize.BUTTON)
        self.notif_mute_btn.set_active(notif_muted)

        self.show_all()


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    app = VolumeControl()
    app.show_all()
    Gtk.main()
