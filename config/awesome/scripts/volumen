#!/usr/bin/env python3

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('GdkPixbuf', '2.0')
from gi.repository import Gtk, GLib, Gdk, GdkPixbuf, Gio
import subprocess
import re
import signal
import sys
import os
import time

NOTIF_SINK_NAME = "notifications"

CSS = """
window.background {
    background-color: #061115;
    border-radius: 12px;
    border: 1px solid #67afc1;
    padding: 4px;
}

box, scrolledwindow, viewport, list {
    background-color: transparent;
}

