@theme "/dev/null"

* {
    background: #0d0d1a;
    foreground: #e2e8f0;
    accent: #06b6d4;
    accent-dim: #000000;
    surface: #1a1a2e;
    darker: #141428;
    active: #06b6d4;
    active-dim: #0891b2;
    muted: #3d3d5c;
    rad: 16px;
    rad-sm: 10px;
    background-color: transparent;
    text-color: var(foreground);
}

window {
    background-color: var(background);
    border: 2px;
    border-color: var(accent);
    border-radius: var(rad);
    width: 320px;
    padding: 0;
    location: center;
    anchor: center;
}

mainbox {
    children: [inputbar, listview];
    spacing: 0;
    padding: 0;
}

inputbar {
    children: [entry];
    spacing: 0;
    margin: 20px 20px 0 20px;
    border-radius: var(rad);
    background-color: var(darker);
    border: 1px;
    border-color: var(muted);
    padding: 10px 16px;
}

entry {
    padding: 0;
    border-radius: var(rad);
    background-color: transparent;
    text-color: var(foreground);
    font: "JetBrainsMono Nerd Font 10";
    placeholder: "Contraseña...";
    placeholder-color: var(muted);
}

listview {
    spacing: 4px;
    padding: 16px 20px 20px 20px;
    lines: 5;
    columns: 1;
    scrollbar: false;
    layout: vertical;
    cursor: pointer;
}

element {
    padding: 10px 16px;
    border-radius: var(rad-sm);
    cursor: pointer;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
}

element selected {
    background-color: var(darker);
    text-color: var(active);
    border: 1px;
    border-color: var(active);
}

element selected.normal {
    background-color: var(darker);
}

element-icon {
    size: 18px;
    padding: 0 10px 0 0;
}

element-text {
    padding: 0;
    horizontal-align: 0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 10";
}

scrollbar {
    handle-color: var(accent-dim);
    handle-width: 4px;
    border-radius: 2px;
}